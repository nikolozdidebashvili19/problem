# --- Required ---------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
# Needed for self-hosted `next start` / Docker (Vercel sets it automatically)
AUTH_TRUST_HOST=true
MONGO_URI=mongodb://localhost:27017/problem-ge

# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Optional until their ticket lands (see todos/) -------------------------
# Cloudinary signed direct uploads (T-012)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Upstash rate limiting (T-008)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (T-031)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend email (T-034)
RESEND_API_KEY=

# Cron endpoints secret, min 16 chars (T-033)
CRON_SECRET=

# Map tiles — MapTiler/Stadia URL with key in production (T-015)
NEXT_PUBLIC_MAP_TILE_URL=
